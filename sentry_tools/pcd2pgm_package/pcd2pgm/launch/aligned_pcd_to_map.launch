<launch>
<node pkg="pcd2pgm" name="pcd2pgm" type="pcd2pgm" output="screen">
<!-- 已对齐 pcd 文件所在路径 -->
<param name="file_directory" value= "$(find fast_lio)/PCD/"/>
<!-- 已对齐 pcd 文件名称，不带 .pcd 后缀 -->
<param name="file_name" value= "map_clean" />
<!-- 先放宽高度范围，避免已对齐点云因 z 偏移再次被滤空 -->
<param name="thre_z_min" value= "-5.0" />
<param name="thre_z_max" value= "5.0" />
<!-- 0 选取高度范围内的，1 选取高度范围外的 -->
<param name="flag_pass_through" value= "0" />
<!-- 半径滤波参数 -->
<param name="thre_radius" value= "0.10" />
<param name="thres_point_count" value= "3" />
<param name="enable_radius_filter" value= "false" />
<!-- 直接使用高度滤波后的点云作为地图输入 -->
<param name="map_cloud_source" value= "pass_through" />
<param name="radius_filter_min_keep_ratio" value= "0.85" />
<!-- 栅格地图参数 -->
<param name="map_resolution" value= "0.08" />
<param name="map_dilation_radius" value= "0" />
<!-- 输入文件已存在，等待时间可保留默认值 -->
<param name="input_file_wait_timeout_sec" value= "30.0" />
<param name="input_file_poll_interval_sec" value= "0.2" />
<!-- 发布的二维栅格地图 topic -->
<param name="map_topic_name" value= "map" />
</node>
</launch>
