<!-- -->
<launch>
<node pkg="pcd2pgm" name="pcd_ground_align" type="pcd_ground_align" output="screen">
<!-- 原始 pcd 文件路径 -->
<param name="file_directory" value= "$(find fast_lio)/PCD/"/>
<!-- 输入 pcd 文件名称 -->
<param name="input_file_name" value= "map_clean" />
<!-- 输出对齐后的 pcd 文件名称 -->
<param name="output_file_name" value= "scans_aligned" />
<!-- 用最低一层点作为地面候选，数值越大，参与拟合的低处点越多 -->
<param name="ground_seed_height" value= "1.0" />
<!-- 地面平面拟合的 RANSAC 阈值 -->
<param name="ransac_distance_threshold" value= "0.12" />
<!-- 对齐后把估计地面平移到 z=0，便于后续按高度做上下层裁剪 -->
<param name="align_ground_to_zero" value= "true" />
<!-- 保存为二进制 pcd，速度更快 -->
<param name="save_binary" value= "true" />
</node>

<node pkg="pcd2pgm" name="pcd2pgm" type="pcd2pgm" output="screen">
<!-- 存放pcd文件的路径-->
<param name="file_directory" value= "$(find fast_lio)/PCD/"/>
<!-- pcd文件名称-->
<param name="file_name" value= "scans_aligned" />
<!-- 选取的范围最小高度(相对地面 z=0)。抬高下限，滤掉地面和贴地噪点 -->
<param name="thre_z_min" value= "-0.20" />
<!-- 选取的范围最大高度(相对地面 z=0)。压低上限，滤掉屋顶/横梁等高处结构 -->
<param name="thre_z_max" value= "-0.10" />
<!--0 选取高度范围内的，１选取高度范围外的-->
<param name="flag_pass_through" value= "0" />
<!-- 半径滤波的半径。若后续开启半径滤波，使用更宽松配置减少稀疏区误删 -->
<param name="thre_radius" value= "0.10" />
<!-- 半径滤波的要求点数个数。降低邻居数门槛，放宽滤波要求 -->
<param name="thres_point_count" value= "3" />
<!-- 是否启用半径滤波。默认关闭，优先保留稀疏区域与墙边轮廓 -->
<param name="enable_radius_filter" value= "false" />
<!-- auto: 自适应选择；pass_through: 直接用高度滤波后的点云；radius: 强制用半径滤波后的点云 -->
<param name="map_cloud_source" value= "pass_through" />
<!-- auto 模式下，半径滤波至少保留多少比例的点，低于该阈值则回退到 pass-through -->
<param name="radius_filter_min_keep_ratio" value= "0.85" />
<!-- 存储的栅格map的分辨率-->
<param name="map_resolution" value= "0.08" />
<!-- 投影到二维栅格后，对占据栅格做膨胀的半径(单位: 栅格). 0=关闭 -->
<param name="map_dilation_radius" value= "0" />
<!-- 等待对齐后的输入文件生成，避免和 pcd_ground_align 启动竞争 -->
<param name="input_file_wait_timeout_sec" value= "30.0" />
<param name="input_file_poll_interval_sec" value= "0.2" />
<!-- 转换后发布的二维地图的topic，默认使用map即可，可使用map_server保存-->
<param name="map_topic_name" value= "map" />
</node>

</launch>
