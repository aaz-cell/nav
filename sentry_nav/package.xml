<?xml version="1.0"?>
<package format="2">
  <name>sentry_nav</name>
  <version>0.2.0</version>
  <description>Launch, configuration, TF, and TEB integration for iSweep navigation experiments.</description>
  <maintainer email="rm@todo.todo">rm</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>costmap_2d</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>teb_local_planner</depend>
  <depend>tf</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>dynamic_obstacle_adapter</exec_depend>
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>fast_lio_localization</exec_depend>
  <exec_depend>global_planner</exec_depend>
  <exec_depend>isweep_planner</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>navigation_adapter</exec_depend>
  <exec_depend>planner_bridge</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>rviz</exec_depend>
</package>
