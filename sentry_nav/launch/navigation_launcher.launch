<launch>
    <arg name="use_conda" default="true" />
    
    <!-- 设置权限 -->
    <node name="set_perms" pkg="rospy" type="sleep" args="1" 
          launch-prefix="bash -c 'sudo chmod 777 /dev/ttyUSB0; sudo chmod 777 /dev/ttyUSB1; $0 $@'" />
    
    <!-- LiDAR -->
    <include file="/home/zhl/robot/sensors_ws/src/rslidar_sdk/launch/start.launch" />
    
    <!-- Data converter -->
    <node pkg="rs_to_velodyne" type="rs_to_velodyne" name="converter" 
          args="m2dgrplus XYZIRT" output="screen" launch-prefix="sleep 3" />
    
    <!-- IMU -->
    <include file="/home/zhl/robot/sensors_ws/src/fdilink_ahrs/launch/ahrs_data.launch" launch-prefix="sleep 2" />
    
    <!-- Base control -->
    <include file="/home/zhl/robot/nav_ws/src/turn_on_wheeltec_robot/launch/include/base_serial.launch" launch-prefix="sleep 2" />
    
    <!-- Localization -->
    <include file="/home/zhl/robot/nav_ws/src/NEXTE_Sentry_Nav/sentry_slam/FAST_LIO_LOCALIZATION/launch/sentry_localize.launch" launch-prefix="sleep 5" />
    
    <!-- Navigation -->
    <node name="nav_launcher" pkg="rospy" type="sleep" args="1" 
          output="screen" 
          launch-prefix="bash -c 'sleep 10; conda run -n nav roslaunch sentry_nav sentry_movebase.launch'" />

</launch>